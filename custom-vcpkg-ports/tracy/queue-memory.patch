+namespace
+{
+    bool SealPointer( uint64_t* field, size_t size )
+    {
+        const auto original = reinterpret_cast<void*>( MemRead( field ) );
+        if( !original || QueuePayload_IsManaged( original ) ) return true;
+        void* copy = QueuePayload_Allocate( size );
+        if( !copy ) return false;
+        memcpy( copy, original, size );
+        tracy_free( original );
+        MemWrite( field, uint64_t( copy ) );
+        return true;
+    }
+    bool SealString( uint64_t* field )
+    {
+        const auto original = reinterpret_cast<const char*>( MemRead( field ) );
+        return !original || SealPointer( field, strlen( original ) + 1 );
+    }
+    bool SealSourceLocation( uint64_t* field )
+    {
+        const auto original = reinterpret_cast<const uint16_t*>( MemRead( field ) );
+        return !original || SealPointer( field, MemRead( original ) );
+    }
+}
