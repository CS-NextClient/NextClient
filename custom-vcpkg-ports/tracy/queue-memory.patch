+TRACY_API bool QueuePayload_SealItem( QueueItem& item )
+{
+    if( QueueMemory_IsStopped() ) return false;
+    switch( item.hdr.type )
+    {
+    case QueueType::ZoneText:
+    case QueueType::ZoneName:
+        return SealPointer( &item.zoneTextFat.text, MemRead( &item.zoneTextFat.size ) );
+    case QueueType::Message:
+    case QueueType::MessageCallstack:
+    case QueueType::MessageAppInfo:
+    {
+        auto tagged = MemRead( &item.messageFat.textAndMetadata );
+        uint64_t pointer = tagged.GetAddress();
+        if( !SealPointer( &pointer, MemRead( &item.messageFat.size ) ) ) return false;
+        MemWrite( &item.messageFat.textAndMetadata, TaggedUserlandAddress( pointer, tagged.GetTag() ) );
+        return true;
+    }
+    case QueueType::MessageColor:
+    case QueueType::MessageColorCallstack:
+    {
+        auto tagged = MemRead( &item.messageColorFat.textAndMetadata );
+        uint64_t pointer = tagged.GetAddress();
+        if( !SealPointer( &pointer, MemRead( &item.messageColorFat.size ) ) ) return false;
+        MemWrite( &item.messageColorFat.textAndMetadata, TaggedUserlandAddress( pointer, tagged.GetTag() ) );
+        return true;
+    }
+    case QueueType::ZoneBeginAllocSrcLoc:
+    case QueueType::ZoneBeginAllocSrcLocCallstack:
+        return SealSourceLocation( &item.zoneBegin.srcloc );
+    case QueueType::GpuZoneBeginAllocSrcLoc:
+    case QueueType::GpuZoneBeginAllocSrcLocCallstack:
+    case QueueType::GpuZoneBeginAllocSrcLocSerial:
+    case QueueType::GpuZoneBeginAllocSrcLocCallstackSerial:
+        return SealSourceLocation( &item.gpuZoneBegin.srcloc );
+    case QueueType::Callstack:
+    case QueueType::CallstackSerial:
+    {
+        const auto trace = reinterpret_cast<const uintptr_t*>( MemRead( &item.callstackFat.ptr ) );
+        return !trace || SealPointer( &item.callstackFat.ptr, ( trace[0] + 1 ) * sizeof( uintptr_t ) );
+    }
+    case QueueType::CallstackSample:
+    case QueueType::CallstackSampleContextSwitch:
+    {
+        const auto trace = reinterpret_cast<const uint64_t*>( MemRead( &item.callstackSampleFat.ptr ) );
+        return !trace || SealPointer( &item.callstackSampleFat.ptr, ( trace[0] + 1 ) * sizeof( uint64_t ) );
+    }
+    case QueueType::CallstackAlloc:
+    {
+        const auto trace = reinterpret_cast<const uintptr_t*>( MemRead( &item.callstackAllocFat.nativePtr ) );
+        if( trace && !SealPointer( &item.callstackAllocFat.nativePtr, ( trace[0] + 1 ) * sizeof( uintptr_t ) ) ) return false;
+        const auto payload = reinterpret_cast<const uint16_t*>( MemRead( &item.callstackAllocFat.ptr ) );
+        return !payload || SealPointer( &item.callstackAllocFat.ptr, sizeof( uint16_t ) + MemRead( payload ) );
+    }
+    case QueueType::SourceCodeMetadata:
+        return SealPointer( &item.sourceCodeMetadata.ptr, MemRead( &item.sourceCodeMetadata.size ) );
+    case QueueType::SymbolCodeMetadata:
+        return SealPointer( &item.symbolCodeMetadata.ptr, MemRead( &item.symbolCodeMetadata.size ) );
+    case QueueType::SymbolInformation:
+        return !MemRead( &item.symbolInformationFat.needFree ) || SealString( &item.symbolInformationFat.fileString );
+    case QueueType::ExternalNameMetadata:
+        return SealString( &item.externalNameMetadata.name ) && SealString( &item.externalNameMetadata.threadName );
+    case QueueType::LockName:
+        return SealPointer( &item.lockNameFat.name, MemRead( &item.lockNameFat.size ) );
+    case QueueType::GpuContextName:
+        return SealPointer( &item.gpuContextNameFat.ptr, MemRead( &item.gpuContextNameFat.size ) );
+    case QueueType::GpuAnnotationName:
+        return SealPointer( &item.gpuAnnotationNameFat.ptr, MemRead( &item.gpuAnnotationNameFat.size ) );
+    case QueueType::SectionEnter:
+        return SealString( &item.sectionEnterFat.text );
+    case QueueType::SectionSetup:
+        return SealString( &item.sectionSetupFat.text );
+    default:
+        return true;
+    }
+}
