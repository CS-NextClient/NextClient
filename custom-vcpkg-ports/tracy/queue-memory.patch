@@ -0,0 +1,258 @@
+#include "TracyQueueMemory.hpp"
+
+#include <atomic>
+#include <mutex>
+#include <string.h>
+#include "../common/TracyAlloc.hpp"
+#include "../common/TracyAssert.hpp"
+
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <sys/mman.h>
+#endif
+
+namespace tracy
+{
+namespace
+{
+    constexpr size_t kQueueLimit = 128u * 1024u * 1024u;
+#ifdef _WIN32
+    constexpr size_t kAllocationGranularity = 64u * 1024u;
+#else
+    constexpr size_t kAllocationGranularity = 4096u;
+#endif
+    struct alignas(16) AllocationHeader
+    {
+        size_t size;
+    };
+    std::atomic<size_t> g_QueueUsed { 0 };
+    std::atomic<size_t> g_QueuePeak { 0 };
+    std::atomic<uint32_t> g_QueueStopped { 0 };
+
+    void StopCapture( uint32_t reason )
+    {
+        uint32_t expected = 0;
+        g_QueueStopped.compare_exchange_strong( expected, reason, std::memory_order_acq_rel );
+    }
+}
+
+void* QueueMemory_Allocate( size_t size )
+{
+    if( QueueMemory_IsStopped() ) return nullptr;
+    if( size > kQueueLimit - sizeof( AllocationHeader ) - ( kAllocationGranularity - 1 ) )
+    {
+        StopCapture( 1 );
+        return nullptr;
+    }
+    const size_t charged = ( size + sizeof( AllocationHeader ) + kAllocationGranularity - 1 ) & ~( kAllocationGranularity - 1 );
+    size_t used = g_QueueUsed.load( std::memory_order_relaxed );
+    for(;;)
+    {
+        if( charged > kQueueLimit - used )
+        {
+            StopCapture( 1 );
+            return nullptr;
+        }
+        if( g_QueueUsed.compare_exchange_weak( used, used + charged, std::memory_order_acq_rel ) ) break;
+    }
+    size_t peak = g_QueuePeak.load( std::memory_order_relaxed );
+    while( peak < used + charged && !g_QueuePeak.compare_exchange_weak( peak, used + charged, std::memory_order_relaxed ) ) {}
+#ifdef _WIN32
+    void* raw = VirtualAlloc( nullptr, charged, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE );
+#else
+    void* raw = mmap( nullptr, charged, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0 );
+    if( raw == MAP_FAILED ) raw = nullptr;
+#endif
+    if( !raw )
+    {
+        g_QueueUsed.fetch_sub( charged, std::memory_order_acq_rel );
+        StopCapture( 2 );
+        return nullptr;
+    }
+    auto header = static_cast<AllocationHeader*>( raw );
+    header->size = charged;
+    return header + 1;
+}
+
+void QueueMemory_Free( void* ptr )
+{
+    if( !ptr ) return;
+    auto header = static_cast<AllocationHeader*>( ptr ) - 1;
+    const size_t charged = header->size;
+#ifdef _WIN32
+    const bool released = VirtualFree( header, 0, MEM_RELEASE ) != 0;
+#else
+    const bool released = munmap( header, charged ) == 0;
+#endif
+    TRACY_ASSERT( released );
+    if( released ) g_QueueUsed.fetch_sub( charged, std::memory_order_acq_rel );
+}
+
+namespace
+{
+    struct PayloadPage;
+    struct alignas(16) PayloadHeader
+    {
+        PayloadPage* page;
+        PayloadHeader* next;
+    };
+    struct alignas(16) PayloadPage
+    {
+        PayloadPage* next;
+        PayloadHeader* free;
+        size_t block_size;
+        size_t live;
+    };
+    constexpr size_t kPayloadPageSize = 64u * 1024u - sizeof( AllocationHeader );
+    constexpr size_t kPayloadClasses = 11;
+    PayloadPage* g_PayloadPages[kPayloadClasses] {};
+    PayloadHeader* g_LargePayloads = nullptr;
+    std::mutex g_PayloadMutex;
+}
+
+void* QueuePayload_Allocate( size_t size )
+{
+    if( QueueMemory_IsStopped() ) return nullptr;
+    if( size > kQueueLimit - sizeof( PayloadHeader ) )
+    {
+        StopCapture( 1 );
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock( g_PayloadMutex );
+    size_t block_size = 32;
+    size_t index = 0;
+    while( block_size < size + sizeof( PayloadHeader ) && index < kPayloadClasses )
+    {
+        block_size *= 2;
+        ++index;
+    }
+    if( index == kPayloadClasses )
+    {
+        auto header = static_cast<PayloadHeader*>( QueueMemory_Allocate( size + sizeof( PayloadHeader ) ) );
+        if( !header ) return nullptr;
+        header->page = nullptr;
+        header->next = g_LargePayloads;
+        g_LargePayloads = header;
+        return header + 1;
+    }
+    PayloadPage* page = g_PayloadPages[index];
+    while( page && !page->free ) page = page->next;
+    if( !page )
+    {
+        page = static_cast<PayloadPage*>( QueueMemory_Allocate( kPayloadPageSize ) );
+        if( !page ) return nullptr;
+        page->next = g_PayloadPages[index];
+        page->free = nullptr;
+        page->block_size = block_size;
+        page->live = 0;
+        g_PayloadPages[index] = page;
+        for( size_t offset = sizeof( PayloadPage ); offset + block_size <= kPayloadPageSize; offset += block_size )
+        {
+            auto header = reinterpret_cast<PayloadHeader*>( reinterpret_cast<char*>( page ) + offset );
+            header->page = page;
+            header->next = page->free;
+            page->free = header;
+        }
+    }
+    auto header = page->free;
+    page->free = header->next;
+    ++page->live;
+    return header + 1;
+}
+
+void QueuePayload_Free( void* ptr )
+{
+    if( !ptr ) return;
+    {
+        std::lock_guard<std::mutex> lock( g_PayloadMutex );
+        auto large = &g_LargePayloads;
+        while( *large )
+        {
+            auto header = *large;
+            if( header + 1 == ptr )
+            {
+                *large = header->next;
+                QueueMemory_Free( header );
+                return;
+            }
+            large = &header->next;
+        }
+        for( size_t index = 0; index < kPayloadClasses; ++index )
+        {
+            auto position = &g_PayloadPages[index];
+            while( *position )
+            {
+                auto page = *position;
+                const uintptr_t address = uintptr_t( ptr );
+                const uintptr_t start = uintptr_t( page ) + sizeof( PayloadPage ) + sizeof( PayloadHeader );
+                if( address >= start && address < uintptr_t( page ) + kPayloadPageSize && ( address - start ) % page->block_size == 0 )
+                {
+                    auto header = static_cast<PayloadHeader*>( ptr ) - 1;
+                    header->next = page->free;
+                    page->free = header;
+                    if( --page->live == 0 )
+                    {
+                        *position = page->next;
+                        QueueMemory_Free( page );
+                    }
+                    return;
+                }
+                position = &page->next;
+            }
+        }
+    }
+    tracy_free( ptr );
+}
+
+bool QueuePayload_IsManaged( const void* ptr )
+{
+    if( !ptr ) return false;
+    std::lock_guard<std::mutex> lock( g_PayloadMutex );
+    for( auto header = g_LargePayloads; header; header = header->next )
+    {
+        if( header + 1 == ptr ) return true;
+    }
+    for( size_t index = 0; index < kPayloadClasses; ++index )
+    {
+        for( auto page = g_PayloadPages[index]; page; page = page->next )
+        {
+            const uintptr_t address = uintptr_t( ptr );
+            const uintptr_t start = uintptr_t( page ) + sizeof( PayloadPage ) + sizeof( PayloadHeader );
+            if( address >= start && address < uintptr_t( page ) + kPayloadPageSize && ( address - start ) % page->block_size == 0 ) return true;
+        }
+    }
+    return false;
+}
+
+char* QueuePayload_CopyString( const char* text )
+{
+    if( !text ) return nullptr;
+    const size_t size = strlen( text ) + 1;
+    auto copy = static_cast<char*>( QueuePayload_Allocate( size ) );
+    if( copy ) memcpy( copy, text, size );
+    return copy;
+}
+
+QueueMemoryStatus QueueMemory_GetStatus()
+{
+    return { g_QueueUsed.load( std::memory_order_acquire ), g_QueuePeak.load( std::memory_order_acquire ), kQueueLimit, g_QueueStopped.load( std::memory_order_acquire ) };
+}
+
+bool QueueMemory_IsStopped()
+{
+    return g_QueueStopped.load( std::memory_order_acquire ) != 0;
+}
+
+bool QueueMemory_IsUnderPressure()
+{
+    return g_QueueUsed.load( std::memory_order_relaxed ) >= kQueueLimit * 3 / 4;
+}
+
+void QueueMemory_Reset()
+{
+    TRACY_ASSERT( g_QueueUsed.load( std::memory_order_acquire ) == 0 );
+    g_QueuePeak.store( 0, std::memory_order_release );
+    g_QueueStopped.store( 0, std::memory_order_release );
+}
+}
