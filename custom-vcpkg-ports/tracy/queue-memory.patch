@@ -0,0 +1,92 @@
+#pragma once
+
+#include <string.h>
+#include "TracyQueueMemory.hpp"
+#include "../common/TracyAssert.hpp"
+
+namespace tracy
+{
+template<typename T>
+void QueueVector_Discard( const T& item )
+{
+    QueuePayload_Free( item.image );
+}
+inline void QueueVector_Discard( const QueueItem& item )
+{
+    QueueMemory_DiscardItem( item );
+}
+template<typename T>
+bool QueueVector_Seal( T& ) { return !QueueMemory_IsStopped(); }
+inline bool QueueVector_Seal( QueueItem& item ) { return QueuePayload_SealItem( item ); }
+template<typename T>
+class QueueVector
+{
+    T* m_ptr = nullptr;
+    T* m_write = nullptr;
+    T* m_end = nullptr;
+    T m_discard {};
+    bool m_discarding = false;
+
+    bool Grow()
+    {
+        const size_t capacity = m_ptr ? size_t( m_end - m_ptr ) : 0;
+        const size_t next = capacity ? capacity * 2 : 16;
+        auto ptr = static_cast<T*>( QueueMemory_Allocate( sizeof( T ) * next ) );
+        if( !ptr ) return false;
+        const size_t count = size();
+        if( count ) memcpy( ptr, m_ptr, count * sizeof( T ) );
+        QueueMemory_Free( m_ptr );
+        m_ptr = ptr;
+        m_write = ptr + count;
+        m_end = ptr + next;
+        return true;
+    }
+
+public:
+    explicit QueueVector( size_t capacity )
+    {
+        m_ptr = static_cast<T*>( QueueMemory_Allocate( sizeof( T ) * capacity ) );
+        m_write = m_ptr;
+        m_end = m_ptr ? m_ptr + capacity : nullptr;
+    }
+    ~QueueVector() { QueueMemory_Free( m_ptr ); }
+    QueueVector( const QueueVector& ) = delete;
+    QueueVector& operator=( const QueueVector& ) = delete;
+    bool empty() const { return m_ptr == m_write; }
+    size_t size() const { return m_ptr ? size_t( m_write - m_ptr ) : 0; }
+    T* data() { return m_ptr; }
+    T* begin() { return m_ptr; }
+    T* end() { return m_write; }
+    T& operator[]( size_t index ) { return m_ptr[index]; }
+    void clear() { m_write = m_ptr; }
+    T* prepare_next()
+    {
+        m_discarding = QueueMemory_IsStopped() || ( m_write == m_end && !Grow() );
+        if( m_discarding )
+        {
+            m_discard = {};
+            return &m_discard;
+        }
+        return m_write;
+    }
+    bool is_discarding() const { return m_discarding; }
+    void commit_next()
+    {
+        if( m_discarding || !QueueVector_Seal( *m_write ) ) QueueVector_Discard( m_discarding ? m_discard : *m_write );
+        else ++m_write;
+    }
+    void commit_retained() { TRACY_ASSERT( !m_discarding ); ++m_write; }
+    void swap( QueueVector& other )
+    {
+        auto ptr = m_ptr;
+        auto write = m_write;
+        auto end = m_end;
+        m_ptr = other.m_ptr;
+        m_write = other.m_write;
+        m_end = other.m_end;
+        other.m_ptr = ptr;
+        other.m_write = write;
+        other.m_end = end;
+    }
+};
+}
