cmake_minimum_required(VERSION 3.21)

if (NOT IS_DIRECTORY "${TEST_BINARY_DIRECTORY}" OR NOT EXISTS "${TEST_BINARY_DIRECTORY}/CMakeCache.txt")
    message(FATAL_ERROR "TEST_BINARY_DIRECTORY must name an existing CMake build directory")
endif ()
file(REAL_PATH "${TEST_BINARY_DIRECTORY}" binary_directory)
set(fixture_directory "${binary_directory}/install-nextclient-fixtures")
if (EXISTS "${fixture_directory}")
    file(REAL_PATH "${fixture_directory}" fixture_directory)
endif ()
cmake_path(IS_PREFIX binary_directory "${fixture_directory}" NORMALIZE fixture_is_inside)
if (NOT fixture_is_inside OR fixture_directory STREQUAL binary_directory)
    message(FATAL_ERROR "Fixture directory must resolve inside the build directory")
endif ()
file(REMOVE_RECURSE "${fixture_directory}")
file(MAKE_DIRECTORY "${fixture_directory}")

if (NOT DEFINED INSTALL_RECIPE)
    set(INSTALL_RECIPE "${CMAKE_CURRENT_LIST_DIR}/../InstallNextClient.cmake")
endif ()

function(Inventory directory result)
    file(GLOB_RECURSE files LIST_DIRECTORIES TRUE RELATIVE "${directory}" "${directory}/*")
    list(SORT files)
    set(inventory "")
    foreach (path IN LISTS files)
        if (IS_DIRECTORY "${directory}/${path}")
            string(APPEND inventory "${path}/ directory\n")
        else ()
            file(SHA256 "${directory}/${path}" hash)
            string(APPEND inventory "${path} ${hash}\n")
        endif ()
    endforeach ()
    set(${result} "${inventory}" PARENT_SCOPE)
endfunction()

function(RequireContent path expected)
    if (NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing installed file: ${path}")
    endif ()
    file(READ "${path}" actual)
    if (NOT actual STREQUAL expected)
        message(FATAL_ERROR "Incorrect installed content: ${path}")
    endif ()
endfunction()

set(platforms Windows Linux)
if (DEFINED PLATFORM_ONLY)
    set(platforms "${PLATFORM_ONLY}")
endif ()
foreach (platform IN LISTS platforms)
    foreach (profiling IN ITEMS OFF ON)
        set(case_directory "${fixture_directory}/${platform}-${profiling} with spaces")
        set(source_directory "${case_directory}/source")
        set(destination "${case_directory}/destination")
        file(MAKE_DIRECTORY "${source_directory}/assets/cstrike/materials/nested" "${destination}/cstrike/cl_dlls")
        set(sources "")
        foreach (name IN ITEMS launcher engine filesystem client gameui steam nitro vgui)
            file(WRITE "${source_directory}/${name}" "new ${name}\n")
            list(APPEND sources "${source_directory}/${name}")
        endforeach ()
        set(destinations cstrike.exe next_engine_mini.dll FileSystem_Proxy.dll cstrike/cl_dlls/client_mini.dll
                cstrike/cl_dlls/GameUI.dll steam_api.dll nitro_api2.dll vgui2.dll)
        if (platform STREQUAL Linux)
            list(TRANSFORM destinations REPLACE "GameUI.dll$" "gameui.so")
            list(TRANSFORM destinations REPLACE "vgui2.dll$" "vgui2.so")
        endif ()
        foreach (path IN LISTS destinations)
            file(WRITE "${destination}/${path}" "old ${path}\n")
        endforeach ()
        file(MAKE_DIRECTORY "${destination}/cstrike/materials")
        file(WRITE "${destination}/cstrike/materials/existing" "old resource\n")
        file(WRITE "${destination}/unrelated" "preserved\n")
        file(WRITE "${destination}/crashpad_handler.exe" "old crashpad\n")
        file(WRITE "${destination}/nextclient.sh" "old launcher script\n")
        file(WRITE "${destination}/TracyClient.runtime" "old tracy\n")
        file(WRITE "${source_directory}/crashpad_handler.exe" "new crashpad\n")
        file(WRITE "${source_directory}/nextclient.sh" "new launcher script\n")
        file(WRITE "${source_directory}/TracyClient.runtime" "new tracy\n")
        file(WRITE "${source_directory}/assets/cstrike/materials/nested/material"
                "version https://git-lfs.github.com/spec/v1\noid sha256:0123456789\nsize 1234\n")
        file(WRITE "${source_directory}/assets/cstrike/resource.txt" "new resource\n")

        set(manifest "${case_directory}/manifest.cmake")
        file(WRITE "${manifest}"
                "set(INSTALL_PLATFORM ${platform})\n"
                "set(INSTALL_DIRECTORY [==[${destination}]==])\n"
                "set(INSTALL_ASSETS_DIRECTORY [==[${source_directory}/assets]==])\n"
                "set(INSTALL_LIBRARY_SOURCES [==[${sources}]==])\n"
                "set(INSTALL_CRASHPAD_SOURCE [==[${source_directory}/crashpad_handler.exe]==])\n"
                "set(INSTALL_LINUX_LAUNCHER_SOURCE [==[${source_directory}/nextclient.sh]==])\n")
        if (profiling)
            file(APPEND "${manifest}" "set(INSTALL_TRACY_SOURCE [==[${source_directory}/TracyClient.runtime]==])\n")
        endif ()
        Inventory("${destination}" before)
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DINSTALL_MANIFEST=${manifest}" -P "${INSTALL_RECIPE}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if (result EQUAL 0 OR NOT "${output}${error}" MATCHES "Git LFS pointers")
            message(FATAL_ERROR "${platform}/${profiling}: pointer material did not fail preflight: ${result}\n${output}${error}")
        endif ()
        Inventory("${destination}" after)
        if (NOT before STREQUAL after)
            message(FATAL_ERROR "${platform}/${profiling}: destination changed before LFS preflight completed\nBefore:\n${before}After:\n${after}")
        endif ()
        if (EXISTS "${destination}/vgui2.so.valve")
            message(FATAL_ERROR "${platform}/${profiling}: preflight created the Valve backup")
        endif ()
        set(absent_manifest "${case_directory}/absent-destination.cmake")
        file(READ "${manifest}" manifest_content)
        file(WRITE "${absent_manifest}" "${manifest_content}set(INSTALL_DIRECTORY [==[${case_directory}/absent destination]==])\n")
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DINSTALL_MANIFEST=${absent_manifest}" -P "${INSTALL_RECIPE}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if (result EQUAL 0 OR NOT "${output}${error}" MATCHES "Git LFS pointers"
                OR EXISTS "${case_directory}/absent destination")
            message(FATAL_ERROR "${platform}/${profiling}: LFS failure created or accepted an absent destination")
        endif ()
        message(STATUS "PASS ${platform}/${profiling}: LFS failure preserved destination names/hashes and created no absent destination")

        file(WRITE "${source_directory}/assets/cstrike/materials/nested/material" "hydrated material\n")
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DINSTALL_MANIFEST=${manifest}" -P "${INSTALL_RECIPE}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if (NOT result EQUAL 0)
            message(FATAL_ERROR "${platform}/${profiling}: hydrated installation failed: ${result}\n${output}${error}")
        endif ()
        set(names launcher engine filesystem client gameui steam nitro vgui)
        foreach (index RANGE 0 7)
            list(GET names ${index} name)
            list(GET destinations ${index} path)
            RequireContent("${destination}/${path}" "new ${name}\n")
        endforeach ()
        RequireContent("${destination}/cstrike/materials/nested/material" "hydrated material\n")
        RequireContent("${destination}/cstrike/resource.txt" "new resource\n")
        RequireContent("${destination}/cstrike/materials/existing" "old resource\n")
        RequireContent("${destination}/unrelated" "preserved\n")
        if (platform STREQUAL Windows)
            RequireContent("${destination}/crashpad_handler.exe" "new crashpad\n")
            RequireContent("${destination}/nextclient.sh" "old launcher script\n")
        else ()
            RequireContent("${destination}/nextclient.sh" "new launcher script\n")
            RequireContent("${destination}/crashpad_handler.exe" "old crashpad\n")
            RequireContent("${destination}/vgui2.so.valve" "old vgui2.so\n")
            execute_process(COMMAND "${CMAKE_COMMAND}" "-DINSTALL_MANIFEST=${manifest}" -P "${INSTALL_RECIPE}"
                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
            if (NOT result EQUAL 0)
                message(FATAL_ERROR "Repeated Linux installation failed: ${result}\n${output}${error}")
            endif ()
            RequireContent("${destination}/vgui2.so.valve" "old vgui2.so\n")
            RequireContent("${destination}/vgui2.so" "new vgui\n")
        endif ()
        if (profiling)
            RequireContent("${destination}/TracyClient.runtime" "new tracy\n")
        else ()
            RequireContent("${destination}/TracyClient.runtime" "old tracy\n")
        endif ()
        message(STATUS "PASS ${platform}/${profiling}: hydrated mappings, resources, optional Tracy and backup preservation")
    endforeach ()
endforeach ()
