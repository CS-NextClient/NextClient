cmake_minimum_required(VERSION 3.21)
include("${PROBE_MANIFEST}")

file(MAKE_DIRECTORY "${PREPARED_DIRECTORY}")
set(prepared_manifest "")
foreach (source IN LISTS RUNTIME_FILES)
    get_filename_component(filename "${source}" NAME)
    file(COPY_FILE "${source}" "${PREPARED_DIRECTORY}/${filename}")
    file(SHA256 "${source}" source_hash)
    file(SHA256 "${PREPARED_DIRECTORY}/${filename}" copied_hash)
    if (NOT source_hash STREQUAL copied_hash)
        message(FATAL_ERROR "Factory probe: copied hash differs for ${filename}")
    endif ()
    string(APPEND prepared_manifest "${copied_hash}  ${filename}\n")
endforeach ()
file(WRITE "${PREPARED_DIRECTORY}/manifest.sha256" "${prepared_manifest}")
get_filename_component(provider_filename "${PROVIDER}" NAME)

if (UNIX)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "LD_LIBRARY_PATH=${PREPARED_DIRECTORY}:$ENV{LD_LIBRARY_PATH}"
            "${PROBE}" "${PREPARED_DIRECTORY}/${provider_filename}" WORKING_DIRECTORY "${PREPARED_DIRECTORY}" RESULT_VARIABLE result)
else ()
    execute_process(COMMAND "${PROBE}" "${PREPARED_DIRECTORY}/${provider_filename}" WORKING_DIRECTORY "${PREPARED_DIRECTORY}" RESULT_VARIABLE result)
endif ()
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Shipping factory probe failed: ${result}")
endif ()
