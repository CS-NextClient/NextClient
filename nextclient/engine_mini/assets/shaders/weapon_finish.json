  "groups": [
    { "name": "base", "label": "#ncl_mat_group_base", "params": ["uBaseTint"] },
    {
      "name": "pattern", "label": "#ncl_mat_group_pattern",
      "params": ["uPattern", "uPatternTint", "uPatternTransform", "uLayerMix"]
    },
    {
      "name": "wear", "label": "#ncl_mat_group_wear",
      "params": ["uWearMap", "uWearMapTransform", "uWear", "uWearSoftness"]
    },
    {
      "name": "underlay", "label": "#ncl_mat_group_underlay",
      "params": ["uUnderlay", "uUnderlayTint", "uUnderlayTransform"]
    },
    {
      "name": "highlight", "label": "#ncl_mat_group_highlight",
      "params": [
        "uReflectMask", "uReflectMaskTransform", "uReflectTint", "uReflectWear",
        "uSpecular", "uGloss", "uSphereMap", "uReflectivity"
      ]
    }
  ],
  "overlays": { "max": 4 }
